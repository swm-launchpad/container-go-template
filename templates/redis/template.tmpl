FROM redis:{{ .redis_version }}-alpine

EXPOSE 6379

VOLUME ["/data"]

CMD ["redis-server", "--appendonly", "yes", "--requirepass", "{{ .redis_password }}"{{ if .maxmemory }}, "--maxmemory", "{{ .maxmemory }}"{{ end }}{{ if .maxmemory_policy }}, "--maxmemory-policy", "{{ .maxmemory_policy }}"{{ end }}]