FROM redis:{{ .redis_version }}-alpine

EXPOSE {{ .redis_port }}

VOLUME ["/data"]

CMD ["redis-server", "--port", "{{ .redis_port }}", "--appendonly", "yes"{{ if .redis_password }}, "--requirepass", "{{ .redis_password }}"{{ end }}{{ if .maxmemory }}, "--maxmemory", "{{ .maxmemory }}"{{ end }}{{ if .maxmemory_policy }}, "--maxmemory-policy", "{{ .maxmemory_policy }}"{{ end }}]