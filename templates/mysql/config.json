{
  "default_env": [
    {
      "key": "MYSQL_ROOT_PASSWORD",
      "value": ""
    },
    {
      "key": "MYSQL_CHARACTER_SET_SERVER",
      "value": "utf8mb4"
    }
  ],
  "default_ports": [
    {
      "internal_port": 3306,
      "network_type": "tcp"
    }
  ],
  "template_options": [
    {
      "default": "8.0",
      "label": "MySQL 버전",
      "name": "version",
      "options": [
        "8.0",
        "8.4",
        "9.0"
      ],
      "type": "select",
      "category": "required"
    },
    {
      "default": "utf8mb4",
      "label": "문자 인코딩",
      "name": "charset",
      "options": [
        "utf8mb4",
        "utf8",
        "latin1"
      ],
      "type": "select",
      "category": "required"
    },
    {
      "default": "myapp",
      "label": "데이터베이스명",
      "name": "database_name",
      "options": [],
      "type": "text",
      "category": "optional"
    },
    {
      "default": "",
      "label": "Root 비밀번호 (선택사항)",
      "name": "root_password",
      "options": [],
      "type": "password",
      "category": "optional"
    },
    {
      "default": "",
      "label": "애플리케이션 사용자명 (선택사항)",
      "name": "user_username",
      "options": [],
      "type": "text",
      "category": "optional"
    },
    {
      "default": "",
      "label": "애플리케이션 비밀번호 (선택사항)",
      "name": "user_password",
      "options": [],
      "type": "password",
      "category": "optional"
    },
    {
      "default": "151",
      "label": "최대 연결 수",
      "name": "max_connections",
      "options": [],
      "type": "number",
      "category": "advanced",
      "description": "동시 접속 가능한 최대 클라이언트 수. 메모리와 트레이드오프 관계."
    },
    {
      "default": "128M",
      "label": "InnoDB 버퍼 풀 크기",
      "name": "innodb_buffer_pool_size",
      "options": [],
      "type": "text",
      "category": "advanced",
      "description": "InnoDB 테이블과 인덱스를 캐싱하는 메모리 크기. 전체 메모리의 50-70% 권장."
    }
  ],
  "template_ports": [
    {
      "description": "MySQL port",
      "internal_port": 3306,
      "network_type": "tcp"
    }
  ],
  "template_volumes": [
    {
      "mount_path": "/var/lib/mysql",
      "capacity": 1024,
      "description": "MySQL 데이터 저장소"
    }
  ]
}
