{
  "default_env": [
    {
      "key": "PYTHONUNBUFFERED",
      "value": "1"
    },
    {
      "key": "PORT",
      "value": "8000"
    }
  ],
  "default_ports": [
    {
      "internal_port": 8000,
      "network_type": "http"
    }
  ],
  "template_options": [
    {
      "default": "3.11",
      "label": "Python 버전",
      "name": "python_version",
      "options": [
        "3.9",
        "3.10",
        "3.11",
        "3.12"
      ],
      "type": "select",
      "category": "required"
    },
    {
      "default": "pip",
      "label": "의존성 매니저",
      "name": "dependency_manager",
      "options": [
        "pip",
        "poetry",
        "pipenv"
      ],
      "type": "select",
      "category": "required"
    },
    {
      "default": "8000",
      "label": "애플리케이션 포트",
      "name": "app_port",
      "options": [],
      "type": "number",
      "category": "optional"
    },
    {
      "default": "main:app",
      "label": "애플리케이션 모듈",
      "name": "app_module",
      "options": [],
      "type": "text",
      "category": "optional"
    },
    {
      "default": "uvicorn",
      "label": "ASGI 서버",
      "name": "asgi_server",
      "options": [
        "uvicorn",
        "hypercorn"
      ],
      "type": "select",
      "category": "advanced",
      "description": "ASGI 애플리케이션 서버. Uvicorn은 빠른 성능, Hypercorn은 HTTP/2 지원."
    },
    {
      "default": "1",
      "label": "워커 프로세스 수",
      "name": "workers",
      "options": [],
      "type": "number",
      "category": "advanced",
      "description": "동시 요청 처리를 위한 워커 프로세스 수. CPU 코어 수와 동일하게 설정 권장."
    }
  ],
  "template_ports": [
    {
      "description": "FastAPI server port",
      "internal_port": 8000,
      "network_type": "http"
    }
  ]
}