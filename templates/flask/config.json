      "options": [
        "pip",
        "poetry",
        "pipenv"
      ],
      "type": "select"
    },
    {
      "default": "5000",
      "label": "애플리케이션 포트",
      "name": "app_port",
      "options": [],
      "type": "number"
    },
    {
      "default": "app:app",
      "label": "애플리케이션 모듈",
      "name": "app_module",
      "options": [],
      "type": "text"
    }
  ],
  "template_ports": [
    {
      "description": "Flask server port",
      "internal_port": 5000,
      "network_type": "http"
    }
  ]
}