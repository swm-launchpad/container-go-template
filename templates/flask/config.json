{
  "default_env": [
    {
      "key": "FLASK_APP",
      "value": "app.py"
    },
    {
      "key": "FLASK_ENV",
      "value": "production"
    }
  ],
  "default_ports": [
    {
      "internal_port": 5000,
      "network_type": "http"
    }
  ],
  "template_options": [
    {
      "default": "3.11",
      "label": "Python 버전",
      "name": "python_version",
      "options": [
        "3.9",
        "3.10",
        "3.11",
        "3.12"
      ],
      "type": "select"
    },
    {
      "default": "pip",
      "label": "의존성 매니저",
