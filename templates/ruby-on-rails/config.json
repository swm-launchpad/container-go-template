{
  "default_env": [
    {
      "key": "RAILS_ENV",
      "value": "production"
    },
    {
      "key": "RAILS_LOG_TO_STDOUT",
      "value": "true"
    }
  ],
  "default_ports": [
    {
      "internal_port": 3000,
      "network_type": "http"
    }
  ],
  "template_options": [
    {
      "default": "3.2",
