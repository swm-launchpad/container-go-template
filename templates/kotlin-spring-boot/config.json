{
  "default_resources": {
    "default_cpu": 1000,
    "default_memory": 1024,
    "min_recommended_memory": 1024
  },
  "default_env": [],
  "port_guide": {
    "default_port": 8080,
    "description": "Spring Boot는 기본적으로 8080번 포트를 사용합니다. 설정에서 server.port를 변경한 경우 해당 포트를 추가하세요."
  },
  "template_options": [
    {
      "default": "17",
      "label": "Java 버전",
      "name": "java_version",
      "options": [
        "17",
        "21"
      ],
      "type": "select",
      "category": "required"
    },
    {
      "default": "8.5",
      "label": "Gradle 버전",
      "name": "gradle_version",
      "options": [
        "8.5"
      ],
      "type": "select",
      "category": "advanced",
      "description": "Gradle 빌드 도구 버전. 특별한 이유가 없다면 기본값 사용을 권장합니다."
    },
    {
      "default": "prod",
      "label": "Spring Profile",
      "name": "spring_profile",
      "options": [
        "dev",
        "prod",
        "test"
      ],
      "type": "select",
      "category": "optional"
    }
  ],
  "template_ports": [
    {
      "description": "Spring Boot server port",
      "internal_port": 8080,
      "network_type": "http"
    }
  ]
}